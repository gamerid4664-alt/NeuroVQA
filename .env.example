# ==============================================================================
# NeuroVQA — Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholder values with your actual secrets.
# ==============================================================================

# Supabase Cloud Project Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
USE_SUPABASE=true

# Local Backend Security
NEUROVQA_SECRET_KEY=generate-a-strong-secret-key-here

# Frontend (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
VITE_API_URL=http://localhost:8000
